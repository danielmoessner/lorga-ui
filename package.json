{
  "name": "lorga-ui-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lorga/playground",
    "build": "npm run build -w lorga-ui",
    "test": "npm run test -w lorga-ui",
    "lint": "npm run lint -w lorga-ui",
    "docs:dev": "npm run docs:dev -w @lorga/docs",
    "docs:build": "npm run docs:build -w @lorga/docs",
    "publish-to-npm": "npm run publish-to-npm -w lorga-ui"
  }
}